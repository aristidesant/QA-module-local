# Example environment variables for local/demo usage
# Copy this file to .env and adjust values before running the app.

# The frontend uses Vite and expects runtime variables prefixed with VITE_
# Base URL for the backend API that the SPA will call. Replace with your API endpoint.
VITE_APP_API_URL=https://api.example.com

# Optional: When building with Docker you can pass this as a build-arg:
# docker build --build-arg VITE_APP_API_URL=https://api.example.com .

# Note: Do NOT commit real secrets or production credentials. Keep them out of source control.
