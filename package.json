{
	"name": "vite-min-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:fix": "prettier --write . && npm run typecheck",
		"prepare": "husky",
		"version:increment": "node scripts/increment-version.cjs",
		"test": "vitest run --coverage --coverage.reporter=text-summary --silent=true",
		"test:watch": "vitest --coverage --coverage.reporter=text-summary --silent=true",
		"coverage:full": "vitest run --coverage",
		"coverage:light": "vitest run --coverage --coverage.reporter=text-summary",
		"coverage": "VALID_COVERAGE_ONLY=true vitest run --coverage --coverage.reporter=text"
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@mantine/carousel": "^8.3.9",
		"@mantine/charts": "^8.3.9",
		"@mantine/core": "^8.3.9",
		"@mantine/dates": "^8.3.9",
		"@mantine/form": "^8.3.9",
		"@mantine/hooks": "^8.3.9",
		"@mantine/modals": "^8.3.9",
		"@mantine/notifications": "^8.3.9",
		"@tabler/icons-react": "^3.35.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-table": "^8.21.3",
		"@uiw/react-markdown-preview": "^5.1.5",
		"@uiw/react-md-editor": "^4.0.11",
		"@xyflow/react": "^12.10.0",
		"axios": "^1.13.2",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"diff": "^8.0.2",
		"i18next": "^25.7.3",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-resources-to-backend": "^1.2.1",
		"jwt-decode": "^4.0.0",
		"react": "^19.2.1",
		"react-arborist": "^3.4.3",
		"react-diff-view": "^3.3.2",
		"react-dom": "^19.2.1",
		"react-grid-layout": "^2.2.2",
		"react-i18next": "^16.5.0",
		"react-router": "^7.10.1",
		"recharts": "^3.5.1",
		"zod": "^4.1.13",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "^4.0.15",
		"baseline-browser-mapping": "^2.9.19",
		"husky": "^9.1.7",
		"jsdom": "^27.2.0",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.7.4",
		"typescript": "^5.9.3",
		"vite": "7.2.6",
		"vitest": "^4.0.15"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	}
}
