{
	"name": "vite-min-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"check:inline-styles": "node scripts/check-inline-styles.cjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:fix": "prettier --write . && npm run typecheck",
		"prepare": "husky",
		"version:increment": "node scripts/increment-version.cjs",
		"test": "vitest run --coverage --coverage.reporter=text-summary --silent=true",
		"test:watch": "vitest --coverage --coverage.reporter=text-summary --silent=true",
		"coverage:full": "vitest run --coverage",
		"coverage:light": "vitest run --coverage --coverage.reporter=text-summary",
		"coverage": "VALID_COVERAGE_ONLY=true vitest run --coverage --coverage.reporter=text"
	},
	"dependencies": {
		"@hello-pangea/dnd": "18.0.1",
		"@mantine/carousel": "9.2.0",
		"@mantine/charts": "9.2.0",
		"@mantine/core": "9.2.0",
		"@mantine/dates": "9.2.0",
		"@mantine/form": "9.2.0",
		"@mantine/hooks": "9.2.0",
		"@mantine/modals": "9.2.0",
		"@mantine/notifications": "9.2.0",
		"@tabler/icons-react": "3.44.0",
		"@tanstack/react-query": "5.100.10",
		"@tanstack/react-table": "8.21.3",
		"@uiw/react-markdown-preview": "5.2.0",
		"@uiw/react-md-editor": "4.1.0",
		"@xyflow/react": "12.10.2",
		"axios": "1.16.0",
		"clsx": "2.1.1",
		"dayjs": "1.11.20",
		"diff": "9.0.0",
		"i18next": "26.1.0",
		"i18next-browser-languagedetector": "8.2.1",
		"i18next-resources-to-backend": "1.2.1",
		"jwt-decode": "4.0.0",
		"react": "19.2.6",
		"react-arborist": "3.6.1",
		"react-diff-view": "3.3.3",
		"react-dom": "19.2.6",
		"react-grid-layout": "2.2.3",
		"react-i18next": "17.0.7",
		"react-resizable": "4.0.1",
		"react-router": "7.15.0",
		"recharts": "3.8.1",
		"zod": "4.4.3",
		"zustand": "5.0.13"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "25.7.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"@vitest/coverage-v8": "4.1.6",
		"baseline-browser-mapping": "2.10.29",
		"husky": "9.1.7",
		"jsdom": "29.1.1",
		"lint-staged": "17.0.4",
		"postcss": "8.5.14",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"prettier": "3.8.3",
		"typescript": "6.0.3",
		"vite": "8.0.12",
		"vitest": "4.1.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	}
}
